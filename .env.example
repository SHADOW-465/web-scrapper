# Required in production. Any long random string. Seals the data-feed tokens the
# browser holds, so they can't be read (they may carry a pasted cookie) or edited
# to point the server somewhere else. Generate one:  openssl rand -base64 32
SCRAPE_SECRET=

# Optional. When set, the app asks for this password before it will scan.
# Every scan runs a browser on your Vercel account; keep this set while the
# deployment URL is public and there are no accounts yet.
APP_PASSWORD=

# Optional, local development only: path to Chrome/Chromium if it isn't found.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Groq (free tier) powers every AI step. Read from the environment only; never
# logged or sent to the browser. https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional backup when Groq is used up or failing: OpenRouter's free models (https://openrouter.ai/keys).
# Used for reading requests and names only; OpenRouter's web search is paid, so website search stays on Groq.
# Free models allow 50 requests a day (1,000 a day once $10 of credits were ever bought on the account).
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,openrouter/free
