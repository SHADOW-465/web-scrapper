# Required in production. Any long random string. Seals the data-feed tokens the
# browser holds, so they can't be read (they may carry a pasted cookie) or edited
# to point the server somewhere else. Generate one:  openssl rand -base64 32
SCRAPE_SECRET=

# Optional. When set, the app asks for this password before it will scan.
# Every scan runs a browser on your Vercel account; keep this set while the
# deployment URL is public and there are no accounts yet.
APP_PASSWORD=

# Optional, local development only: path to Chrome/Chromium if it isn't found.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
